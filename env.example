# Plantilla de configuracion. `configurar.ps1` la usa como referencia y escribe:
#   .env            -> NISAR_DATA, NISAR_MEDIA, PORT (Docker y run.ps1)
#   nisar-app/.env  -> EARTHDATA_USER, EARTHDATA_PASSWORD

# Carpeta donde se bajan los .h5 (pueden ocupar GB).
NISAR_DATA=D:/nisar

# Carpeta donde quedan los artefactos de los jobs (PNG, JSON, GeoTIFF).
NISAR_MEDIA=D:/nisar-media

# Puerto local de la app.
PORT=8010

# Earthdata Login: obligatorio para bajar los .h5 desde ASF.
# El browse publico y la busqueda no piden credenciales.
EARTHDATA_USER=
EARTHDATA_PASSWORD=

# Opcionales.
# CLIMATE3D_DATOS=D:/Dataset era5
# NISAR_BROWSE_CACHE=D:/nisar-media/.cache
