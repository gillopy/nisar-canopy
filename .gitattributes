# Normalizacion de finales de linea.
# *.bat necesita CRLF: cmd.exe con LF puede cortar lineas dentro de bloques.
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yml text eol=lf

# Binarios: sin diffs ni conversion.
*.png binary
*.jpg binary
*.webp binary
*.woff2 binary
*.h5 binary
*.hdf5 binary
